{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chord Composer",
  "version": "0.0.0",
  "identifier": "com.jpmmaia.chord-composer",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5174 --strictPort",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chord Composer",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
